{
  "name": "testwise",
  "version": "0.1.0",
  "description": "Testwise: a no-code, end-to-end test agent. Plain English in, deterministic Playwright tests out.",
  "private": true,
  "type": "module",
  "bin": {
    "testwise": "./bin/testwise.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "cli": "tsx src/cli/index.ts",
    "server": "tsx src/server/index.ts",
    "web:dev": "cd web && npm run dev",
    "web:build": "cd web && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc -p tsconfig.json --noEmit",
    "eval": "tsx eval/run-eval.ts",
    "demo-app": "tsx demo-app/server.ts",
    "seed": "tsx src/cli/index.ts seed"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.68.0",
    "@axe-core/playwright": "4.14.0",
    "axe-core": "4.11.1",
    "better-sqlite3": "13.2.0",
    "chalk": "6.0.1",
    "commander": "15.1.0",
    "cors": "2.8.6",
    "express": "5.3.0",
    "node-cron": "4.6.0",
    "nanoid": "6.0.2",
    "pixelmatch": "8.0.0",
    "playwright": "1.65.1",
    "pngjs": "7.0.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "22.19.1",
    "@types/node-cron": "3.0.11",
    "@types/pixelmatch": "7.1.0",
    "@types/pngjs": "6.0.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.1"
  }
}
